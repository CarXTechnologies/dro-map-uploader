/* MapBuilder window.

   Colours are kept relative to the editor skin (translucent white / black overlays) rather than hardcoded greys, so
   the window keeps working if the user switches between the dark and light editor themes. */

.mb-root {
    flex-grow: 1;
}

/* --- Shared --- */

.mb-row {
    flex-direction: row;
    align-items: center;
}

.mb-grow {
    flex-grow: 1;
}

.mb-field {
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* The changelog box is sized in MapBuilderEditorWindow.StretchToMultiline instead. A rule cannot do it from here:
   the inner input of a TextField is identified by the *name* "unity-text-input", not by a class of that name, so a
   ".mb-changelog-field .unity-text-input" selector matches nothing at all. */

.mb-section-header {
    -unity-font-style: bold;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 6px;
}

.mb-box {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    /* Only the top edge is drawn, as a highlight. Setting a width on all four sides while colouring one of them
       leaves the other three at the default colour, which reads as a broken frame. */
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    padding: 10px;
    margin-bottom: 10px;
}

.mb-muted {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
}

/* --- Vendor bar --- */

.mb-vendor-bar {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    background-color: rgba(0, 0, 0, 0.18);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.4);
}

.mb-game-preview {
    width: 60px;
    height: 28px;
    margin: 0 8px;
    border-radius: 2px;
}

.mb-auth-state {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    margin-right: 8px;
}

.mb-unavailable {
    margin: 24px;
}

/* --- Left panel / preview / build & publish --- */

.mb-main-layout {
    flex-grow: 1;
    flex-direction: row;
}

.mb-left-panel {
    width: 380px;
    min-width: 340px;
    padding: 10px;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.35);
    position: relative;
}

.mb-preview-box {
    height: 200px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 4px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.mb-preview-image {
    width: 100%;
    height: 100%;
}

.mb-preview-missing {
    position: absolute;
    max-width: 220px;
}

.mb-id-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 3px;
    padding: 2px 6px;
}

.mb-id-badge-label {
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
}

.mb-description-box {
    background-color: rgba(0, 0, 0, 0.12);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 10px;
    min-height: 56px;
}

.mb-description-text {
    white-space: normal;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
}

.mb-description-text-empty {
    color: rgba(255, 255, 255, 0.45);
    -unity-font-style: italic;
}

.mb-build-button {
    min-width: 70px;
    margin-left: 6px;
}

.mb-build-result-box {
    margin-bottom: 4px;
}

.mb-build-result-item {
    margin-bottom: 4px;
}

.mb-destination-group {
    margin-bottom: 8px;
}

.mb-publish-status {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: italic;
    margin-bottom: 6px;
}

.mb-publish-button {
    width: 100%;
    max-width: 100%;
    height: 26px;
    margin-top: 4px;
    flex-grow: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mb-external-path-field {
    min-width: 0;
    max-width: 90%;
    overflow: hidden;
}

.mb-icon-button {
    width: 24px;
    height: 20px;
    margin-left: 4px;
    padding: 0;
}

/* --- Right panel / item list --- */

.mb-right-panel {
    flex-grow: 1;
    padding: 10px;
}

.mb-list-header {
    margin-bottom: 6px;
    justify-content: space-between;
}

.mb-items-scroll {
    flex-grow: 1;
}

.mb-empty-hint {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    -unity-font-style: italic;
    white-space: normal;
    margin: 12px 4px;
}

.mb-item-row {
    flex-direction: row;
    align-items: center;
    height: 58px;
    padding: 4px 6px;
    margin-bottom: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.03);
    /* A transparent accent is reserved on every row so that selecting one does not shift its contents sideways. */
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    position: relative;
}

.mb-item-row-odd {
    background-color: rgba(0, 0, 0, 0.12);
}

.mb-item-row:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.mb-item-row-selected {
    background-color: rgba(88, 148, 214, 0.18);
    border-left-color: rgb(88, 148, 214);
}

.mb-item-row-old .mb-item-title {
    color: rgb(217, 140, 38);
}

.mb-item-thumb {
    width: 96px;
    height: 54px;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 2px;
    margin-right: 10px;
}

.mb-item-thumb-loading {
    opacity: 0.6;
}

.mb-item-info {
    flex-grow: 1;
}

.mb-item-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
}

.mb-item-size {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 2px;
}

.mb-item-old-badge {
    color: rgb(217, 140, 38);
    -unity-font-style: bold;
    font-size: 11px;
    margin-right: 8px;
}

.mb-item-warning {
    position: absolute;
    top: 4px;
    right: 6px;
    color: rgb(219, 90, 90);
    font-size: 10px;
    -unity-font-style: bold;
}

.mb-new-item-button {
    height: 28px;
    margin-top: 6px;
}
